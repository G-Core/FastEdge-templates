# ============================================================================
# SSO CDN filter configuration
# ============================================================================
# Copy this file to .env and fill in real values. .env is git-ignored.
#
# Prefixes map to the Gcore portal:
#   FASTEDGE_VAR_ENV_<KEY>     -> Environment Variables (non-sensitive config)
#   FASTEDGE_VAR_SECRET_<KEY>  -> Secret Manager (sensitive values)
#
# This filter runs in the CDN proxy in front of the protected resource. On
# every request it verifies the session token and either lets the request
# through or redirects to login. What else it does — which JWT algorithm it
# trusts, whether it strips the session cookie, whether it injects x-sso-*
# identity headers upstream — is controlled entirely by SSO_VARIANT below. It
# pairs with the SSO auth-app; SSO_VARIANT must be set to the SAME value on
# both apps.
#
# ----------------------------------------------------------------------------
# Keys shared with the auth-app — these MUST match the auth-app's .env
# ----------------------------------------------------------------------------
#   SSO_VARIANT         must equal the auth-app's SSO_VARIANT
#   SESSION_SECRET       (gate-only / header) must equal the auth-app's SESSION_SECRET
#   SESSION_PUBLIC_JWK    (cookie) must be the public key matching the auth-app's SESSION_SIGNING_KEY
#   SSO_AUDIENCE         must equal the auth-app's SSO_AUDIENCE
#   SSO_ISSUER           (optional) only checked when set on BOTH sides
#   SESSION_COOKIE       must equal the auth-app's SESSION_COOKIE
# ============================================================================


# --- Variant selection ------------------------------------------------------

# REQUIRED and fail-closed. Selects the identity-delivery behavior:
#   gate-only — allow/deny only, no identity forwarded, strips the session cookie
#   cookie    — leaves the (ES256) session cookie in place for the origin to verify
#   header    — strips the session cookie, injects x-sso-* identity headers upstream
# The filter refuses EVERY session if this is unset or not one of these three
# values. Must equal the auth-app's SSO_VARIANT.
FASTEDGE_VAR_ENV_SSO_VARIANT=cookie


# --- Token verification ------------------------------------------------------

# REQUIRED for gate-only/header (HS256). HMAC secret used to verify the session
# token. Must be IDENTICAL to the auth-app's SESSION_SECRET.
FASTEDGE_VAR_SECRET_SESSION_SECRET=change-me-to-a-long-random-string

# REQUIRED for cookie (ES256). Public key (JWK JSON) used to verify the session
# token. Must be the public half of the auth-app's SESSION_SIGNING_KEY (the
# auth-app serves it at /auth/.well-known/jwks.json and prints it from
# scripts/gen-ec-keypair.mjs).
# FASTEDGE_VAR_ENV_SESSION_PUBLIC_JWK={"kty":"EC","crv":"P-256","x":"...","y":"..."}


# --- Token binding (audience / issuer) -------------------------------------

# REQUIRED and fail-closed. The filter refuses EVERY session unless this is set
# and equals the token's `aud`. Set it to the SAME value as the auth-app's
# SSO_AUDIENCE. (Distinct value per deployment = isolated sessions; the same value
# on two apps = sessions deliberately shared between them.)
FASTEDGE_VAR_ENV_SSO_AUDIENCE=https://app.example.com

# OPTIONAL. When set, the token's `iss` must match. Only meaningful if the
# auth-app also sets SSO_ISSUER. Leave unset to skip the issuer check.
# FASTEDGE_VAR_ENV_SSO_ISSUER=https://auth.example.com


# --- Request handling ------------------------------------------------------

# Cookie name to read the session token from. Must match the auth-app.
# Default: sso_session
FASTEDGE_VAR_ENV_SESSION_COOKIE=sso_session

# Path prefix where the auth-app is mounted. The filter bypasses all requests
# under this prefix so the login/callback flow is never gated. Must match the
# CDN rule that routes to the auth-app. Default: /auth
# Set this when your origin already uses /auth and you mount the auth-app elsewhere
# (e.g. AUTH_PREFIX=/sso-auth). LOGIN_PAGE_URL defaults to <AUTH_PREFIX>/ when unset.
# FASTEDGE_VAR_ENV_AUTH_PREFIX=/auth

# Where to send unauthenticated users. Default: <AUTH_PREFIX>/ (the built-in
# chooser, served by the auth-app under the same host). Set to a full URL to use
# a custom login page. The original URL is appended as ?redirect=<encoded>.
# FASTEDGE_VAR_ENV_LOGIN_PAGE_URL=/auth/
