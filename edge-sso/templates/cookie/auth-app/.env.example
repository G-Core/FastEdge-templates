# ============================================================================
# Cookie variant — auth-app configuration
# ============================================================================
# Copy this file to .env and fill in real values. .env is git-ignored — never
# commit real secrets.
#
# Two prefixes map to two places in the Gcore portal:
#   FASTEDGE_VAR_ENV_<KEY>     -> Environment Variables (non-sensitive config)
#   FASTEDGE_VAR_SECRET_<KEY>  -> Secret Manager (sensitive values)
#
# This is the COOKIE variant: the session token is an ES256 JWT the origin can
# verify itself using the public key. The auth-app signs with a private key; the
# CDN filter (and your origin, if it checks the token) verify with the public JWK.
#
# ----------------------------------------------------------------------------
# Keys shared with the CDN filter — these MUST match the filter's .env
# ----------------------------------------------------------------------------
#   SESSION_PUBLIC_JWK  the filter verifies the session token with this public key
#   SSO_AUDIENCE        the filter rejects any token whose aud != this value
#   SSO_ISSUER          (optional) checked by the filter only when set on both
#   SESSION_COOKIE      the cookie name the filter reads
# See the filter's .env.example for the matching side.
# ============================================================================


# --- Session signing (cookie variant: ES256) -------------------------------

# Private signing key (PKCS#8 PEM, P-256). Signs the session token.
# Generate a keypair with: node scripts/gen-ec-keypair.mjs
# The script prints both this private key and the public JWK below.
FASTEDGE_VAR_SECRET_SESSION_SIGNING_KEY=-----BEGIN PRIVATE KEY-----\nMIGH...your-ec-private-key...\n-----END PRIVATE KEY-----

# Public key as a JWK (JSON). Served at GET /auth/.well-known/jwks.json and used
# by the CDN filter to verify tokens. MUST correspond to SESSION_SIGNING_KEY above.
FASTEDGE_VAR_ENV_SESSION_PUBLIC_JWK={"kty":"EC","crv":"P-256","x":"...","y":"..."}

# HMAC secret for the SHORT-LIVED flow cookies (OAuth `state`, SAML relay +
# request binding). Required in EVERY variant — it is separate from the session
# token signing key above. Use a long random string; keep it stable per deployment.
FASTEDGE_VAR_SECRET_SESSION_SECRET=change-me-to-a-long-random-string


# --- Token binding (audience / issuer) -------------------------------------

# REQUIRED. The audience this deployment's tokens are for — the filter refuses
# every session unless its SSO_AUDIENCE matches the token's `aud`. Think of it as
# this protected property's identity (like a Cloudflare Access "AUD tag").
#   - Isolate apps (default): give each deployment its OWN unique value.
#   - Share sessions across apps (one login spans several sites): set the SAME
#     value on every app that should accept the shared session.
# Must match SSO_AUDIENCE on this deployment's CDN filter.
FASTEDGE_VAR_ENV_SSO_AUDIENCE=https://app.example.com

# OPTIONAL. Issuer claim embedded in the token. The filter validates it only when
# SSO_ISSUER is set on BOTH the auth-app and the filter. The signing key already
# establishes issuer trust, so this is defense-in-depth / observability, not a gate.
# FASTEDGE_VAR_ENV_SSO_ISSUER=https://auth.example.com


# --- Session cookie --------------------------------------------------------

# Cookie name that carries the session token. MUST match SESSION_COOKIE on the
# CDN filter. Change only if "sso_session" collides with an existing cookie.
# Default: sso_session
FASTEDGE_VAR_ENV_SESSION_COOKIE=sso_session


# ============================================================================
# Identity providers — enable one or more. A provider is "configured" when its
# credential below is present; SSO_PROVIDERS (further down) can narrow the set.
# ============================================================================

# --- SAML (Okta, Azure AD, OneLogin, Shibboleth, ...) ----------------------
# IdP single sign-on URL (where the AuthnRequest is sent).
FASTEDGE_VAR_ENV_IDP_SSO_URL=https://your-idp.example.com/sso/saml
# IdP entityID — must equal the Issuer in the IdP's signed assertions.
FASTEDGE_VAR_ENV_IDP_ENTITY_ID=https://your-idp.example.com
# This SP's entityID and ACS URL (register both with the IdP). The ACS URL is
# where the IdP POSTs the SAMLResponse: <your-host>/auth/callback
FASTEDGE_VAR_ENV_SP_ENTITY_ID=https://app.example.com
FASTEDGE_VAR_ENV_SP_ACS_URL=https://app.example.com/auth/callback
# IdP signing certificate (PEM or bare base64). Used to verify the assertion.
FASTEDGE_VAR_SECRET_IDP_CERT=-----BEGIN CERTIFICATE-----\nMIIC...your-idp-cert...\n-----END CERTIFICATE-----

# --- Google (OIDC) — https://console.cloud.google.com/apis/credentials ------
# Authorized redirect URI: https://app.example.com/auth/callback/google
FASTEDGE_VAR_ENV_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
FASTEDGE_VAR_SECRET_GOOGLE_CLIENT_SECRET=your-google-client-secret
FASTEDGE_VAR_ENV_GOOGLE_REDIRECT_URI=https://app.example.com/auth/callback/google

# --- GitHub (OAuth) — https://github.com/settings/developers ----------------
# Authorization callback URL: https://app.example.com/auth/callback/github
FASTEDGE_VAR_ENV_GITHUB_CLIENT_ID=your-github-client-id
FASTEDGE_VAR_SECRET_GITHUB_CLIENT_SECRET=your-github-client-secret

# --- Microsoft (OIDC) — https://entra.microsoft.com app registrations -------
# Redirect URI: https://app.example.com/auth/callback/microsoft
FASTEDGE_VAR_ENV_MICROSOFT_CLIENT_ID=your-microsoft-client-id
FASTEDGE_VAR_SECRET_MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
FASTEDGE_VAR_ENV_MICROSOFT_REDIRECT_URI=https://app.example.com/auth/callback/microsoft
# Tenant: your tenant id/domain for a single-tenant app, or one of the wildcards
# common | organizations | consumers. Default: common.
# WARNING: a wildcard lets ANY Microsoft tenant sign in. To restrict, either set
# a specific tenant here, or list permitted tenant ids in MICROSOFT_ALLOWED_TENANTS.
# FASTEDGE_VAR_ENV_MICROSOFT_TENANT=common
# Comma-separated tenant ids (the token `tid`) allowed to sign in. Strongly
# recommended when MICROSOFT_TENANT is a wildcard.
# FASTEDGE_VAR_ENV_MICROSOFT_ALLOWED_TENANTS=11111111-2222-3333-4444-555555555555

# --- Facebook (OAuth) — https://developers.facebook.com/apps ----------------
# Valid OAuth Redirect URI: https://app.example.com/auth/callback/facebook
FASTEDGE_VAR_ENV_FACEBOOK_CLIENT_ID=your-facebook-app-id
FASTEDGE_VAR_SECRET_FACEBOOK_CLIENT_SECRET=your-facebook-app-secret
FASTEDGE_VAR_ENV_FACEBOOK_REDIRECT_URI=https://app.example.com/auth/callback/facebook


# ============================================================================
# Behaviour / policy
# ============================================================================

# Which providers to show, comma-separated (google,github,microsoft,facebook,saml).
# Omit to enable every provider whose credentials are present above.
# FASTEDGE_VAR_ENV_SSO_PROVIDERS=google,saml

# Identity claims to embed in the session token beyond the subject (sub).
# Comma-separated from: email,name,picture,given_name,family_name. Default: none.
# (Header variant forwards these to the origin as x-sso-* request headers.)
# FASTEDGE_VAR_ENV_SSO_CLAIMS=email,name

# SAML attribute mapping (JSON) — override the built-in attribute-name fallbacks
# when your IdP uses non-standard names. Maps claim -> SAML attribute Name.
# FASTEDGE_VAR_ENV_SAML_CLAIM_MAP={"email":"user.email","name":"user.displayName"}


# --- Redirects -------------------------------------------------------------

# Allowlist of origins permitted as ?redirect= targets after login (comma-
# separated). Relative paths are always allowed; absolute URLs must be listed
# here. Leave empty to permit relative redirects only (safe default).
FASTEDGE_VAR_ENV_SSO_ALLOWED_ORIGINS=https://app.example.com

# Canonical host. Requests arriving on any other Host are 301-redirected here
# (keeps the OAuth/SAML callback host stable). Omit to disable.
# FASTEDGE_VAR_ENV_CANONICAL_HOST=app.example.com


# --- Login page branding (optional) ----------------------------------------
# The built-in chooser at /auth/ styles itself from these.
# FASTEDGE_VAR_ENV_LOGIN_PAGE_TITLE=Sign in
# FASTEDGE_VAR_ENV_LOGIN_PAGE_SUBTITLE=Choose a sign-in method
# FASTEDGE_VAR_ENV_LOGIN_PAGE_LOGO_URL=https://app.example.com/logo.svg
# FASTEDGE_VAR_ENV_LOGIN_PAGE_FAVICON_URL=https://app.example.com/favicon.ico
# FASTEDGE_VAR_ENV_LOGIN_PAGE_ACCENT_COLOR=#0066cc
# FASTEDGE_VAR_ENV_LOGIN_PAGE_BACKGROUND_COLOR=#f0f2f5
# FASTEDGE_VAR_ENV_LOGIN_PAGE_CSS_URL=https://app.example.com/login.css
# Label/icon for the SAML button (the others use each IdP's own branding).
# FASTEDGE_VAR_ENV_IDP_LABEL=Company SSO
# FASTEDGE_VAR_ENV_IDP_ICON_URL=https://app.example.com/sso-icon.svg


# --- Advanced / testing overrides (rarely needed) --------------------------
# Point providers at non-default or mock endpoints (self-hosted GitHub, test
# doubles, regional Graph hosts, etc.). Leave unset to use the public endpoints.
# FASTEDGE_VAR_ENV_GOOGLE_OAUTH_BASE_URL=https://accounts.google.com
# FASTEDGE_VAR_ENV_GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# FASTEDGE_VAR_ENV_GITHUB_OAUTH_BASE_URL=https://github.com
# FASTEDGE_VAR_ENV_GITHUB_API_BASE_URL=https://api.github.com
# FASTEDGE_VAR_ENV_MICROSOFT_OAUTH_BASE_URL=https://login.microsoftonline.com
# FASTEDGE_VAR_ENV_FACEBOOK_OAUTH_BASE_URL=https://www.facebook.com
# FASTEDGE_VAR_ENV_FACEBOOK_API_BASE_URL=https://graph.facebook.com
# FASTEDGE_VAR_ENV_FACEBOOK_API_VERSION=v21.0
