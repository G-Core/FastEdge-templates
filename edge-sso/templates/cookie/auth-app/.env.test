# Test fixture — safe to commit. All credentials are fake/generated for testing only.
# Copy to .env before running integration tests:
#   cp .env.test .env
#
# The EC keypair and X.509 cert were generated specifically for this test fixture.
# They are NOT production credentials and cannot be used to access any real service.

# Session signing (cookie variant — ES256)
FASTEDGE_VAR_SECRET_SESSION_SIGNING_KEY=-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgH9pkkS7YQB3+L1J0\nBZJu1iIOfBhnQ9scxNhKcwCk/Z6hRANCAATimcQezu0KypsUjdLVwrQwXz8o/R8U\ngkq6ut1+LxO4jRUlCiWQwL3mggfhlee+gVbphMvVQ5AG1pxEM/Wt1Dxw\n-----END PRIVATE KEY-----
FASTEDGE_VAR_ENV_SESSION_PUBLIC_JWK={"kty":"EC","x":"4pnEHs7tCsqbFI3S1cK0MF8_KP0fFIJKurrdfi8TuI0","y":"FSUKJZDAveaCB-GV576BVumEy9VDkAbWnEQz9a3UPHA","crv":"P-256"}

# HMAC secret for short-lived flow cookies (OAuth state, SAML relay)
FASTEDGE_VAR_SECRET_SESSION_SECRET=deadbeefdeadbeefdeadbeefdeadbeefdeadbeef

# Token binding
FASTEDGE_VAR_ENV_SSO_AUDIENCE=https://app.test.example.com
FASTEDGE_VAR_ENV_SSO_ISSUER=https://auth.test.example.com

# SAML — test IdP (redirects point here; no real IdP verification in unit/integration tests)
FASTEDGE_VAR_ENV_IDP_SSO_URL=https://idp.test.example.com/sso/saml
FASTEDGE_VAR_ENV_IDP_ENTITY_ID=https://idp.test.example.com
FASTEDGE_VAR_ENV_SP_ENTITY_ID=https://auth.test.example.com
FASTEDGE_VAR_ENV_SP_ACS_URL=https://auth.test.example.com/auth/callback
# Self-signed test certificate (bare base64 DER, no PEM headers)
FASTEDGE_VAR_SECRET_IDP_

# GitHub OAuth — fake test app credentials
FASTEDGE_VAR_ENV_GITHUB_CLIENT_ID=fake-github-client-id-for-tests
FASTEDGE_VAR_SECRET_GITHUB_CLIENT_SECRET=fake-github-client-secret-for-tests

# Google OIDC — fake test app credentials
FASTEDGE_VAR_ENV_GOOGLE_CLIENT_ID=fake-google-client-id.apps.googleusercontent.com
FASTEDGE_VAR_SECRET_GOOGLE_CLIENT_SECRET=fake-google-client-secret-for-tests
FASTEDGE_VAR_ENV_GOOGLE_REDIRECT_URI=https://auth.test.example.com/auth/callback/google

# Redirect allowlist
FASTEDGE_VAR_ENV_SSO_ALLOWED_ORIGINS=https://app.test.example.com
